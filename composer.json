{
    "name": "durjaygp/durjay-views",
    "description": "A unified polymorphic view counter for Laravel models.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "durjaygp"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Durjaygp\\DurjayViews\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Durjaygp\\DurjayViews\\DurjayViewsServiceProvider"
            ]
        }
    }
}